# Copy this file to .env.local (never committed) and fill in the values.
# In production, set these variables on the container (docker compose env_file / Kubernetes secret).

# Basic Authentication of the /admin page and of the /api/admin/* routes.
# Access is refused when either value is missing.
# Generate a password with: py -3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_USER=
ADMIN_PASSWORD=

# Maestro, called server side only (never exposed to the browser).
# Default: http://treasure-inc-maestro:8082 (docker compose / Kubernetes service name).
# Locally, with the docker compose of treasure-inc-conf: http://localhost:8082
MAESTRO_URL=http://localhost:8082
# Same value as maestro.apikey in Maestro (sent in the X-API-KEY header).
MAESTRO_API_KEY=
# Optional, default 10000
# MAESTRO_TIMEOUT_MS=10000
